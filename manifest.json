{
  "manifest_version": 3,
  "name": "IMDbPlay",
  "version": "1.2",
  "description": "Play movies and TV shows directly from IMDb. Now with less ads!",

  "host_permissions": [
    "https://www.imdb.com/title/tt*"
  ],

  "content_scripts": [
    {
      "matches": ["https://www.imdb.com/title/tt*"],
      "js": ["script.js"]
    }
  ],

  "action": {
    "default_popup": "about.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}